# Copy to .env — never commit real keys.
# Planner: any OpenAI-compatible chat endpoint with tool calling (DeepSeek on Azure for the hackathon)
PLANNER_BASE_URL=https://crux-hackathon-swe.openai.azure.com/openai/v1/
PLANNER_API_KEY=
PLANNER_MODEL=DeepSeek-V4-Pro
# Vision (reference analysis, render critique, asset tagging) + image generation
OPENAI_API_KEY=sk-...
VISION_MODEL=gpt-4.1
IMAGE_MODEL=gpt-image-1
# Where brand workspaces live (default: ../brands)
# BRANDS_DIR=/path/to/brands
PORT=8787
